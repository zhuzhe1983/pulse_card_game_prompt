      "expected_error": "JSON_FLOAT"
    },
    {
      "name": "exponent_token",
      "input_utf8": "{\"x\":1e0}",
      "expected_error": "JSON_FLOAT"
    },
    {
      "name": "duplicate_key",
      "input_utf8": "{\"x\":1,\"x\":2}",
      "expected_error": "JSON_DUPLICATE_KEY"
    },
    {
      "name": "negative_zero",
      "input_utf8": "{\"x\":-0}",
      "expected_error": "NON_CANONICAL_JSON"
    },
    {
      "name": "non_ascii_key",
      "input_utf8": "{\"名字\":\"A\"}",
      "expected_error": "JSON_KEY"
    },
    {
      "name": "lone_surrogate",
      "input_utf8": "{\"x\":\"\\ud800\"}",
      "expected_error": "JSON_INVALID_UNICODE"
    },
    {
      "name": "unsafe_integer",
      "input_utf8": "{\"x\":9007199254740992}",
      "expected_error": "JSON_INTEGER_RANGE"
    },
    {
      "name": "different_action_same_id",
      "mutate_fixture": "handshake_and_play.command_a_1_retry.body.row = rear",
      "expected_error": "ACTION_ID_CONFLICT",
      "expected_revision_delta": 0
    },
    {
      "name": "stale_fresh_action",
      "description": "Fresh action_id with expected_revision=0 while current revision=1",
      "expected_error": "STALE_REVISION",
      "expected_revision_delta": 0
    },
    {
      "name": "forged_actor",
      "mutate_fixture": "handshake_and_play.command_a_1.body.actor = 1",
      "expected_error": "INVALID_MESSAGE",
      "expected_revision_delta": 0
    },
    {
      "name": "unknown_required_message",
      "mutate_fixture": "unknown_optional.X_ROOM_EMOTE.type = FUTURE_COMBAT",
      "expected_error": "UNSUPPORTED_MESSAGE",
      "expected_revision_delta": 0
    },
    {
      "name": "content_hash_mismatch",
      "description": "READY.content_hash differs from SELECT.content_hash",
      "expected_error": "CONTENT_MISMATCH",
      "expect": "No match start."
    },
    {
      "name": "unknown_opcode",
      "description": "SELECT.required_opcodes has an opcode missing from HELLO.effect_opcodes",
      "expected_error": "UNSUPPORTED_EFFECT",
      "expect": "No READY or match start."
    }
