{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcg:schema:battle-view:1",
  "type": "object",
  "properties": {
    "ruleset_id": {
      "const": "pcg.core.v1"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "match_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "round_index": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "phase": {
      "enum": [
        "playing",
        "finished"
      ]
    },
    "round_starter": {
      "enum": [
        0,
        1
      ]
    },
    "turn_player": {
      "enum": [
        null,
        0,
        1
      ]
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "player_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "minLength": 1,
            "maxLength": 64
          },
          "hand": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "instance_id": {
                  "type": "string",
                  "pattern": "^p[01]:0[0-9]$"
                },
                "template_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "instance_id",
                "template_id"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 10
          },
          "board": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "instance_id": {
                  "type": "string",
                  "pattern": "^p[01]:0[0-9]$"
                },
                "template_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "minLength": 1,
                  "maxLength": 64
                },
                "row": {
                  "enum": [
                    "front",
                    "rear"
                  ]
                },
                "base_power": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                },
                "power": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 109
                },
                "shield": {
                  "type": "boolean"
                },
                "stable": {
                  "type": "boolean"
                },
                "deploy_order": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                }
              },
              "required": [
                "instance_id",
                "template_id",
                "row",
                "base_power",
                "power",
                "shield",
                "stable",
                "deploy_order"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 5
          },
          "discard": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "instance_id": {
                  "type": "string",
                  "pattern": "^p[01]:0[0-9]$"
                },
                "template_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "instance_id",
                "template_id"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 10
          },
          "played_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "passed": {
            "type": "boolean"
          },
          "match_points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "hand_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "player_id",
          "board",
          "discard",
          "played_count",
          "passed",
          "match_points",
          "hand_count"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "round_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round_index": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "minItems": 2,
            "maxItems": 2
          },
          "winner": {
            "enum": [
              null,
              0,
              1
            ]
          },
          "awards": {
            "type": "array",
            "items": {
              "enum": [
                0,
                1,
                2
              ]
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "round_index",
          "scores",
          "winner",
          "awards"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 3
    },
    "winner": {
      "enum": [
        null,
        0,
        1
      ]
    },
    "result_reason": {
      "enum": [
        null,
        "points"
      ]
    },
    "viewer_seat": {
      "enum": [
        null,
        0,
        1
      ]
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": [
    "ruleset_id",
    "content_hash",
    "match_id",
    "revision",
    "round_index",
    "phase",
    "round_starter",
    "turn_player",
    "players",
    "round_results",
    "winner",
    "result_reason",
    "viewer_seat",
    "scores"
  ],
  "additionalProperties": false,
  "description": "In addition to schema: only viewer_seat has hand; spectators have neither hand. hand_count equals own hand length. Never leak hidden templates or instances via presentation/events."
}
