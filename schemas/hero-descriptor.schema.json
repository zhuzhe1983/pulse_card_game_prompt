{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcg:schema:hero-descriptor:1",
  "type": "object",
  "properties": {
    "hero_schema_version": {
      "const": 1
    },
    "hero_card_id": {
      "type": "string",
      "pattern": "^(uid:[0-9a-f]{64}|issued:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
    },
    "mode": {
      "enum": [
        "fixed",
        "blind_box"
      ]
    },
    "fixed_template_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "pool_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "hero_schema_version",
    "hero_card_id",
    "mode",
    "fixed_template_id",
    "pool_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "fixed"
          }
        }
      },
      "then": {
        "properties": {
          "fixed_template_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "minLength": 1,
            "maxLength": 64
          },
          "pool_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "fixed_template_id": {
            "type": "null"
          },
          "pool_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    }
  ]
}
