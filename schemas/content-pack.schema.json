{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcg:schema:content-pack:1",
  "type": "object",
  "properties": {
    "content_schema_version": {
      "const": 1
    },
    "content_pack_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "content_pack_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "ruleset_id": {
      "const": "pcg.core.v1"
    },
    "required_ops": {
      "type": "array",
      "items": {
        "enum": [
          "NONE",
          "BOOST",
          "DAMAGE",
          "SELF_BOOST_OTHER_ROW"
        ]
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "required_traits": {
      "type": "array",
      "items": {
        "enum": [
          "shield_once",
          "stable"
        ]
      },
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "unit",
              "tactic"
            ]
          },
          "base_power": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "allowed_rows": {
            "type": "array",
            "items": {
              "enum": [
                "front",
                "rear"
              ]
            },
            "minItems": 0,
            "maxItems": 2,
            "uniqueItems": true
          },
          "traits": {
            "type": "array",
            "items": {
              "enum": [
                "shield_once",
                "stable"
              ]
            },
            "minItems": 0,
            "maxItems": 2,
            "uniqueItems": true
          },
          "effect": {
            "type": "object",
            "properties": {
              "op": {
                "enum": [
                  "NONE",
                  "BOOST",
                  "DAMAGE",
                  "SELF_BOOST_OTHER_ROW"
                ]
              },
              "amount": {
                "enum": [
                  0,
                  2
                ]
              }
            },
            "required": [
              "op",
              "amount"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "template_id",
          "kind",
          "base_power",
          "allowed_rows",
          "traits",
          "effect"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "tactic"
                }
              }
            },
            "then": {
              "properties": {
                "base_power": {
                  "const": 0
                },
                "allowed_rows": {
                  "maxItems": 0
                },
                "traits": {
                  "maxItems": 0
                },
                "effect": {
                  "properties": {
                    "op": {
                      "enum": [
                        "BOOST",
                        "DAMAGE"
                      ]
                    },
                    "amount": {
                      "const": 2
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "allowed_rows": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "effect": {
                  "properties": {
                    "op": {
                      "const": "NONE"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "effect": {
                  "properties": {
                    "amount": {
                      "const": 0
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "effect": {
                  "properties": {
                    "amount": {
                      "const": 2
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "minItems": 10,
      "maxItems": 1024
    },
    "standard_loan_template_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "minLength": 1,
        "maxLength": 64
      },
      "minItems": 10,
      "maxItems": 1024,
      "uniqueItems": true
    },
    "starter_deck": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "minLength": 1,
        "maxLength": 64
      },
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true
    },
    "draw_pools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pool_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "minLength": 1,
            "maxLength": 64
          },
          "pool_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "minLength": 1,
            "maxLength": 64
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "template_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "minLength": 1,
                  "maxLength": 64
                },
                "weight": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "collection_rarity": {
                  "enum": [
                    "ordinary",
                    "hero"
                  ]
                }
              },
              "required": [
                "template_id",
                "weight",
                "collection_rarity"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 1024
          }
        },
        "required": [
          "pool_id",
          "pool_version",
          "entries"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "duplicate_shards": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cosmetics": {
      "type": "object",
      "properties": {
        "ink_unlock_shards": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "available_skin_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "ink_unlock_shards",
        "available_skin_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "content_schema_version",
    "content_pack_id",
    "content_pack_version",
    "ruleset_id",
    "required_ops",
    "required_traits",
    "cards",
    "standard_loan_template_ids",
    "starter_deck",
    "draw_pools",
    "duplicate_shards",
    "cosmetics"
  ],
  "additionalProperties": false
}
